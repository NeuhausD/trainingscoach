# Kopieren nach .env.local und Werte eintragen. Anleitungen in docs/setup/.

# Auth.js (openssl rand -base64 32)
AUTH_SECRET=
# Microsoft Entra ID (docs/setup/entra-id.md)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Login-Allowlist, kommagetrennt. Erste Adresse ist Standard für npm run db:seed.
ALLOWED_EMAILS=

# Neon Postgres (docs/setup/vercel-neon.md)
DATABASE_URL=

# Strava-API-Anwendung (docs/setup/strava.md); Verify-Token frei wählen (openssl rand -hex 16)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Verschlüsselung der Strava-Tokens (32 Bytes, base64: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Vercel Blob für FIT-Dateien (optional; ohne Token wird die Datei nur ausgewertet, nicht abgelegt)
BLOB_READ_WRITE_TOKEN=

# KI-Anbieter: anthropic | openai, Modell optional (ADR 0005)
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Wetter-Standort (Open-Meteo), Standard Plaffeien
HOME_LAT=46.743
HOME_LON=7.288

# Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
